<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicit, reproducible package sources. Committed so every developer, agent,
  and CI run restores from the SAME feeds. Do NOT put credentials here; use
  environment-based auth for private feeds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
