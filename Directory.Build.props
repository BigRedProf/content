<Project>

	<!--
	Shared package metadata for every project in this repository.

	This is the BigRedProf publishing standard, and it is deliberately in ONE
	file rather than repeated per-csproj: the whole point is that our public
	packages look the same, and three copies of the same eight properties drift.
	Only genuinely per-package facts (title, description, tags) live in the
	csproj.

	The sibling `data` and `stories` repositories carry their own copy, the
	same way each repository carries its own `script/common.ps1`. The canonical
	version belongs in the foundation repository.
	-->

	<PropertyGroup>
		<Authors>BigRedProf</Authors>
		<Company>Big Red Professor</Company>
		<Copyright>Big Red Professor</Copyright>
		<PackageProjectUrl>https://github.com/BigRedProf/content</PackageProjectUrl>
		<RepositoryUrl>https://github.com/BigRedProf/content</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!--
		An SPDX expression rather than a packed LICENSE file. Both are supported;
		the expression is what nuget.org renders as a real license name instead of
		"license.txt", and it cannot drift from the LICENSE in the repository root
		the way a copied file can.
		-->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!--
	Source, symbols, and reproducibility.

	This replaces the `DebugType=embedded` HACKHACK that used to sit in each
	packable csproj. That workaround existed because GitHub Packages does not
	accept symbol packages; nuget.org does, so real .snupkg symbols are back and
	the comment explaining the compromise is gone.

	`dotnet nuget push foo.nupkg` pushes a foo.snupkg sitting beside it
	automatically, so CI needs no extra step for these.
	-->
	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<!--
	Deterministic builds, but only in CI. Locally this would replace source paths
	with unreadable placeholders in the debugger, which is a bad trade on a
	developer machine; in CI it is what lets a package be rebuilt from its commit.
	-->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!--
	The version comes from the git tag, not from a number typed into a csproj.

	Gating the release on a tag is only half the job: with a hand-maintained
	<Version>, someone can tag v0.2.0 and publish 0.1.0 — the gate looks right
	and the artifact is wrong. MinVer makes the tag the single source of truth,
	so the two cannot disagree.

	MinVerMinimumMajorMinor keeps untagged builds on the version line this package
	is actually at (0.1.x) rather than 0.0.0-alpha.0.N. Unlike its siblings, this
	package has no nuget.org history to stay ahead of, so the first release here
	can legitimately be v0.1.0.

	NOTE: MinVer reads git history, so CI must check out with fetch-depth: 0.
	A shallow clone has no tags and every build silently becomes an alpha.
	-->
	<PropertyGroup>
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" PrivateAssets="All" />
	</ItemGroup>

	<!--
	The readme is packed only where a package is actually produced. Without the
	condition, every test project would try to pack a file it never ships.
	-->
	<ItemGroup Condition="'$(IsPackable)' != 'false'">
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
